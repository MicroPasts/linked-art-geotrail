{
  "name": "@micropasts/linked-art-geotrail",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist-lib/linked-art-geotrail.cjs",
  "module": "./dist-lib/linked-art-geotrail.js",
  "exports": {
    ".": {
      "import": "./dist-lib/linked-art-geotrail.js",
      "require": "./dist-lib/linked-art-geotrail.cjs"
    },
    "./style.css": "./dist-lib/linked-art-geotrail.css"
  },
  "files": [
    "dist-lib",
    "dist-umd"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:docs": "BUILD_TARGET=docs vite build --outDir docs",
    "build:lib": "BUILD_TARGET=lib vite build --outDir dist-lib",
    "build:umd": "BUILD_TARGET=umd vite build --outDir dist-umd",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^4.7.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1"
  }
}